# --- required in production ---
PUBLIC_URL=https://api.example.com        # base of signed video URLs
FILE_SECRET=change-me-64-hex-chars         # signs video URLs; keep stable across restarts
SUPABASE_JWT_SECRET=                       # empty = dev auth via x-user-id header (never in prod)

# --- optional ---
PORT=8080
DATA_DIR=./data                            # sqlite db + stored videos (local storage adapter)
ROLE=all                                   # all | api | worker
REDIS_URL=                                 # set to use BullMQ instead of the in-process queue
RENDER_CONCURRENCY=1                       # renders at the same time per worker process
RENDER_WORKERS=4                           # browser pages per render (parallel frame ranges)
RENDER_SHORT=720                           # short side in px (720 -> 720x1280 for 9:16)
RENDER_FPS=24
MAX_ACTIVE_JOBS=3                          # per user, queued + running
URL_TTL=3600                               # seconds a video link stays valid
WEBHOOK_URL=                               # POSTed {jobId,status,videoUrl|errors} with x-signature HMAC
WEBHOOK_SECRET=
ELEVENLABS_VOICE_ID=                       # voice for narrated renders (key comes from ELEVENLABS_API_KEY)
LOG=1
